   43:
   44:	  0056			CHK_TRI:
   45:	  0056	D2 95		    SETB P1.5           ; 熄灭锯齿波灯
   46:
   47:				    ; 3. 检测三角波开关 (P1.2)
   48:	  0058	20 92 09	    JB P1.2, CHK_SINE   ; 未按下，查正弦波
   49:
   50:				    ; P1.2按下 (三角波选择)
   51:	  005B	C2 96		    CLR P1.6            ; 点亮三角波指示灯
   52:	  005D	D2 97		    SETB P1.7
   53:	  005F	12 00 A6	    LCALL WAVE_TRI      ; 调用三角波子程序
   54:	  0062	80 D2		    SJMP MAIN_LOOP
   55:
   56:	  0064			CHK_SINE:
   57:	  0064	D2 96		    SETB P1.6           ; 熄灭三角波灯
   58:
   59:				    ; 4. 检测正弦波开关 (P1.3)
   60:	  0066	20 93 07	    JB P1.3, ALL_OFF    ; 未按下，去全灭逻辑
   61:
   62:				    ; P1.3按下 (正弦波选择)
   63:	  0069	C2 97		    CLR P1.7            ; 点亮正弦波指示灯
   64:	  006B	12 00 C8	    LCALL WAVE_SINE     ; 调用正弦波子程序
   65:	  006E	80 C6		    SJMP MAIN_LOOP
   66:
   67:	  0070			ALL_OFF:
   68:	  0070	D2 97		    SETB P1.7           ; 熄灭正弦波灯
   69:				    ; 如果没有按键按下，保持输出不变或输出0，这里选择循环检测
   70:	  0072	80 C2		    SJMP MAIN_LOOP
   71:
   72:				;====================================================================
   73:				; 通用延时子程序 (频率控制)
   74:				; P2值越大 -> 频率越高 -> 延时越短    算法: 延时次数 = (255 - P2值)
   75:				;====================================================================
   76:	  0074			DELAY_FREQ:
   77:	  0074	C0 E0		    PUSH ACC            ; 保护累加器
   78:	  0076	C0 07		    PUSH 07H            ; 保护R7
   79:
   80:	  0078	E5 A0		    MOV A, FREQ_PORT    ; 读取P2口频率设定值
   81:	  007A	F4		    CPL A               ; 取反 (例如: P2=255(FF) -> A=0; P2=0 -> A=255)
   82:	  007B	60 03		    JZ DELAY_MIN        ; 如果结果为0，说明P2是255(最高频)，直接返回
   83:
   84:	  007D	FF		    MOV R7, A           ; 将反码存入R7作为循环次数
   85:	  007E			DLY_LOOP:
   86:	  007E	DF FE		    DJNZ R7, DLY_LOOP   ; 简单的软件延时循环
   87:
   88:	  0080			DELAY_MIN:
   89:	  0080	D0 07		    POP 07H
   90:	  0082	D0 E0		    POP ACC
   91:	  0084	22		    RET
   92:
   93:				;====================================================================
   94:				; 1. 方波生成子程序（输出00H -> 延时 -> 输出FFH -> 延时）
   95:				; 与其他波形频率近似（每周期约256步），循环调用延时128次高电平/128次低�
				��平
   96:				;====================================================================
   97:	  0085			WAVE_SQUARE:

ASEM-51 V1.3                                         Copyright (c) 2002 by W.W. Heinz                                         PAGE 3



 Line  I  Addr  Code            Source

   98:	  0085	7E 80		    MOV R6, #128        ; 半周期计数
   99:	  0087			SQ_HIGH:
  100:	  0087	75 80 FF	    MOV DAC_PORT, #0FFH ; 输出最大值
  101:	  008A	12 00 74	    LCALL DELAY_FREQ
  102:	  008D	DE F8		    DJNZ R6, SQ_HIGH
  103:
  104:	  008F	7E 80		    MOV R6, #128        ; 半周期计数
  105:	  0091			SQ_LOW:
  106:	  0091	75 80 00	    MOV DAC_PORT, #00H  ; 输出最小值
  107:	  0094	12 00 74	    LCALL DELAY_FREQ
  108:	  0097	DE F8		    DJNZ R6, SQ_LOW
  109:	  0099	22		    RET
  110:
  111:				;====================================================================
  112:				; 2. 锯齿波生成子程序（0 -> 255, 步长2）
  113:				;====================================================================
  114:	  009A			WAVE_SAW:
  115:	  009A	74 00		    MOV A, #00H         ;以此为起点
  116:	  009C			SAW_LOOP:
  117:	  009C	F5 80		    MOV DAC_PORT, A     ; 输出当前值
  118:	  009E	12 00 74	    LCALL DELAY_FREQ    ; 延时
  119:	  00A1	24 02		    ADD A, #02H         ; 步长 +2
  120:	  00A3	70 F7		    JNZ SAW_LOOP        ; 如果没溢出回0，继续循环
  121:	  00A5	22		    RET
  122:
  123:				;====================================================================
  124:				; 3. 三角波生成子程序（0 -> 254 (上升), 254 -> 0 (下降), 步长2）
  125:				;====================================================================
  126:	  00A6			WAVE_TRI:
  127:	  00A6	74 00		    MOV A, #00H         ; 起点
  128:
  129:				    ; 上升段 (0 -> 254)
  130:	  00A8			TRI_UP:
  131:	  00A8	F5 80		    MOV DAC_PORT, A
  132:	  00AA	12 00 74	    LCALL DELAY_FREQ
  133:	  00AD	24 02		    ADD A, #02H
  134:	  00AF	B4 FE 02	    CJNE A, #0FEH, TRI_CHK_UP ; 判断是否达到254 (0FEH)
  135:	  00B2	80 02		    SJMP TRI_DOWN_START       ; 达到顶点，开始下降
  136:	  00B4			TRI_CHK_UP:
  137:	  00B4	40 F2		    JC TRI_UP                 ; 如果A < FE，继续上升
  138:
  139:				    ; 下降段 (254 -> 0)
  140:	  00B6			TRI_DOWN_START:
  141:	  00B6	74 FE		    MOV A, #0FEH
  142:	  00B8			TRI_DOWN:
  143:	  00B8	F5 80		    MOV DAC_PORT, A
  144:	  00BA	12 00 74	    LCALL DELAY_FREQ
  145:	  00BD	C3		    CLR C
  146:	  00BE	94 02		    SUBB A, #02H
  147:	  00C0	70 F6		    JNZ TRI_DOWN        ; 直到减到0
  148:	  00C2	F5 80		    MOV DAC_PORT, A     ; 输出最后的0
  149:	  00C4	12 00 74	    LCALL DELAY_FREQ
  150:	  00C7	22		    RET
  151:
  152:				;====================================================================
  153:				; 4. 正弦波生成子程序 (查表法)

