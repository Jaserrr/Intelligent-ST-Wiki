   20:				    ; 1. 检测方波开关 (P1.0)
   21:	  0036	20 90 0D	    JB P1.0, CHK_SAW    ; 如果P1.0是高电平(未按下)，跳转检查锯齿波
   22:
   23:				    ; P1.0按下 (方波选择)
   24:	  0039	C2 94		    CLR P1.4            ; 点亮方波指示灯 (P1.4)
   25:	  003B	D2 95		    SETB P1.5           ; 熄灭其他灯
   26:	  003D	D2 96		    SETB P1.6
   27:	  003F	D2 97		    SETB P1.7
   28:	  0041	12 00 85	    LCALL WAVE_SQUARE   ; 调用方波子程序
   29:	  0044	80 F0		    SJMP MAIN_LOOP      ; 执行完一周期后重新检测（实现循环）
   30:
   31:	  0046			CHK_SAW:
   32:	  0046	D2 94		    SETB P1.4           ; 熄灭方波灯
   33:
   34:				    ; 2. 检测锯齿波开关 (P1.1)
   35:	  0048	20 91 0B	    JB P1.1, CHK_TRI    ; 未按下，查三角波
   36:
   37:				    ; P1.1按下 (锯齿波选择)
   38:	  004B	C2 95		    CLR P1.5            ; 点亮锯齿波指示灯
   39:	  004D	D2 96		    SETB P1.6
   40:	  004F	D2 97		    SETB P1.7
   41:	  0051	12 00 9A	    LCALL WAVE_SAW      ; 调用锯齿波子程序
   42:	  0054	80 E0		    SJMP MAIN_LOOP

