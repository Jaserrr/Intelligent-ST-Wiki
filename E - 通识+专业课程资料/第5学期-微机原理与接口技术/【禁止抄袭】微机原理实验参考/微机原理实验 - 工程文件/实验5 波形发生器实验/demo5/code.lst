    3:		D      0090	SW_INPUT    EQU P1      ; P1.0-P1.3 为波形选择开关
    4:		D      0090	LED_PORT    EQU P1      ; P1.4-P1.7 为波形指示灯
    5:		D      00A0	FREQ_PORT   EQU P2      ; 频率控制输入口
