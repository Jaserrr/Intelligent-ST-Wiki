   11:		N      0030	ORG 0030H
   12:	  0030			START:
   13:				    ; 初始化
   14:	  0030	75 80 80	    MOV DAC_PORT, #80H  ; DAC输出中间值
   15:	  0033	75 90 FF	    MOV P1, #0FFH       ; P1口置高：低4位做输入准备，高4位LED全灭(设LED低电平亮
				)
   16:
   17:	  0036			MAIN_LOOP:
   18:				    ; --- 流程图逻辑开始 ---
