  154:				; 逻辑: 查表输出0-255个点
  155:				;====================================================================
  156:	  00C8			WAVE_SINE:
  157:	  00C8	90 00 D9	    MOV DPTR, #SINE_TABLE ; 指向表头
  158:	  00CB	7E 00		    MOV R6, #0            ; 计数器 0-255
  159:	  00CD			SINE_LOOP:
  160:	  00CD	EE		    MOV A, R6
  161:	  00CE	93		    MOVC A, @A+DPTR       ; 查表
