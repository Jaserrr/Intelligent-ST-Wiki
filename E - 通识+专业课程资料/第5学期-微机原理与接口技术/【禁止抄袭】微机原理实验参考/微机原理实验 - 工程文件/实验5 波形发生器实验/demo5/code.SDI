,,,;--- 寄存器定义 ---
000D,,,DAC_PORT    EQU P0      ; DAC0832 数据口
000D,,,SW_INPUT    EQU P1      ; P1.0-P1.3 为波形选择开关
000D,,,LED_PORT    EQU P1      ; P1.4-P1.7 为波形指示灯
000D,,,FREQ_PORT   EQU P2      ; 频率控制输入口
,,,
,,,;--- 程序入口 ---
,,,ORG 0000H
0000,02 00 30,,    LJMP START
,,,
,,,ORG 0030H
0030,,START,START:
,,,    ; 初始化
0030,75 80 80,,    MOV DAC_PORT, #80H  ; DAC输出中间值
0033,75 90 FF,,    MOV P1, #0FFH       ; P1口置高：低4位做输入准备，高4位LED全灭(设LED低电平亮
,,,
0036,,MAIN_LOOP,MAIN_LOOP:
,,,    ; --- 流程图逻辑开始 ---
,,,
,,,    ; 1. 检测方波开关 (P1.0)
0036,20 90 0D,,    JB P1.0, CHK_SAW    ; 如果P1.0是高电平(未按下)，跳转检查锯齿波
,,,
,,,    ; P1.0按下 (方波选择)
0039,C2 94,,    CLR P1.4            ; 点亮方波指示灯 (P1.4)
003B,D2 95,,    SETB P1.5           ; 熄灭其他灯
003D,D2 96,,    SETB P1.6
003F,D2 97,,    SETB P1.7
0041,12 00 85,,    LCALL WAVE_SQUARE   ; 调用方波子程序
0044,80 F0,,    SJMP MAIN_LOOP      ; 执行完一周期后重新检测（实现循环）
,,,
0046,,CHK_SAW,CHK_SAW:
0046,D2 94,,    SETB P1.4           ; 熄灭方波灯
,,,
,,,    ; 2. 检测锯齿波开关 (P1.1)
0048,20 91 0B,,    JB P1.1, CHK_TRI    ; 未按下，查三角波
,,,
,,,    ; P1.1按下 (锯齿波选择)
004B,C2 95,,    CLR P1.5            ; 点亮锯齿波指示灯
004D,D2 96,,    SETB P1.6
004F,D2 97,,    SETB P1.7
0051,12 00 9A,,    LCALL WAVE_SAW      ; 调用锯齿波子程序
0054,80 E0,,    SJMP MAIN_LOOP
,,,
0056,,CHK_TRI,CHK_TRI:
0056,D2 95,,    SETB P1.5           ; 熄灭锯齿波灯
,,,
,,,    ; 3. 检测三角波开关 (P1.2)
0058,20 92 09,,    JB P1.2, CHK_SINE   ; 未按下，查正弦波
,,,
,,,    ; P1.2按下 (三角波选择)
005B,C2 96,,    CLR P1.6            ; 点亮三角波指示灯
005D,D2 97,,    SETB P1.7
005F,12 00 A6,,    LCALL WAVE_TRI      ; 调用三角波子程序
0062,80 D2,,    SJMP MAIN_LOOP
,,,
0064,,CHK_SINE,CHK_SINE:
0064,D2 96,,    SETB P1.6           ; 熄灭三角波灯
,,,
,,,    ; 4. 检测正弦波开关 (P1.3)
0066,20 93 07,,    JB P1.3, ALL_OFF    ; 未按下，去全灭逻辑
,,,
,,,    ; P1.3按下 (正弦波选择)
0069,C2 97,,    CLR P1.7            ; 点亮正弦波指示灯
006B,12 00 C8,,    LCALL WAVE_SINE     ; 调用正弦波子程序
006E,80 C6,,    SJMP MAIN_LOOP
,,,
0070,,ALL_OFF,ALL_OFF:
0070,D2 97,,    SETB P1.7           ; 熄灭正弦波灯
,,,    ; 如果没有按键按下，保持输出不变或输出0，这里选择循环检测
0072,80 C2,,    SJMP MAIN_LOOP
,,,
,,,;====================================================================
,,,; 通用延时子程序 (频率控制)
,,,; P2值越大 -> 频率越高 -> 延时越短    算法: 延时次数 = (255 - P2值)
,,,;====================================================================
0074,,DELAY_FREQ,DELAY_FREQ:
0074,C0 E0,,    PUSH ACC            ; 保护累加器
0076,C0 07,,    PUSH 07H            ; 保护R7
,,,
0078,E5 A0,,    MOV A, FREQ_PORT    ; 读取P2口频率设定值
007A,F4,,    CPL A               ; 取反 (例如: P2=255(FF) -> A=0; P2=0 -> A=255)
007B,60 03,,    JZ DELAY_MIN        ; 如果结果为0，说明P2是255(最高频)，直接返回
,,,
007D,FF,,    MOV R7, A           ; 将反码存入R7作为循环次数
007E,,DLY_LOOP,DLY_LOOP:
007E,DF FE,,    DJNZ R7, DLY_LOOP   ; 简单的软件延时循环
,,,
0080,,DELAY_MIN,DELAY_MIN:
0080,D0 07,,    POP 07H
0082,D0 E0,,    POP ACC
0084,22,,    RET
,,,
,,,;====================================================================
,,,; 1. 方波生成子程序（输出00H -> 延时 -> 输出FFH -> 延时）
,,,; 与其他波形频率近似（每周期约256步），循环调用延时128次高电平/128次低�
,,,;====================================================================
0085,,WAVE_SQUARE,WAVE_SQUARE:
0085,7E 80,,    MOV R6, #128        ; 半周期计数
0087,,SQ_HIGH,SQ_HIGH:
0087,75 80 FF,,    MOV DAC_PORT, #0FFH ; 输出最大值
008A,12 00 74,,    LCALL DELAY_FREQ
008D,DE F8,,    DJNZ R6, SQ_HIGH
,,,
008F,7E 80,,    MOV R6, #128        ; 半周期计数
0091,,SQ_LOW,SQ_LOW:
0091,75 80 00,,    MOV DAC_PORT, #00H  ; 输出最小值
0094,12 00 74,,    LCALL DELAY_FREQ
0097,DE F8,,    DJNZ R6, SQ_LOW
0099,22,,    RET
,,,
,,,;====================================================================
,,,; 2. 锯齿波生成子程序（0 -> 255, 步长2）
,,,;====================================================================
009A,,WAVE_SAW,WAVE_SAW:
009A,74 00,,    MOV A, #00H         ;以此为起点
009C,,SAW_LOOP,SAW_LOOP:
009C,F5 80,,    MOV DAC_PORT, A     ; 输出当前值
009E,12 00 74,,    LCALL DELAY_FREQ    ; 延时
00A1,24 02,,    ADD A, #02H         ; 步长 +2
00A3,70 F7,,    JNZ SAW_LOOP        ; 如果没溢出回0，继续循环
00A5,22,,    RET
,,,
,,,;====================================================================
,,,; 3. 三角波生成子程序（0 -> 254 (上升), 254 -> 0 (下降), 步长2）
,,,;====================================================================
00A6,,WAVE_TRI,WAVE_TRI:
00A6,74 00,,    MOV A, #00H         ; 起点
,,,
,,,    ; 上升段 (0 -> 254)
00A8,,TRI_UP,TRI_UP:
00A8,F5 80,,    MOV DAC_PORT, A
00AA,12 00 74,,    LCALL DELAY_FREQ
00AD,24 02,,    ADD A, #02H
00AF,B4 FE 02,,    CJNE A, #0FEH, TRI_CHK_UP ; 判断是否达到254 (0FEH)
00B2,80 02,,    SJMP TRI_DOWN_START       ; 达到顶点，开始下降
00B4,,TRI_CHK_UP,TRI_CHK_UP:
00B4,40 F2,,    JC TRI_UP                 ; 如果A < FE，继续上升
,,,
,,,    ; 下降段 (254 -> 0)
00B6,,TRI_DOWN_START,TRI_DOWN_START:
00B6,74 FE,,    MOV A, #0FEH
00B8,,TRI_DOWN,TRI_DOWN:
00B8,F5 80,,    MOV DAC_PORT, A
00BA,12 00 74,,    LCALL DELAY_FREQ
00BD,C3,,    CLR C
00BE,94 02,,    SUBB A, #02H
00C0,70 F6,,    JNZ TRI_DOWN        ; 直到减到0
00C2,F5 80,,    MOV DAC_PORT, A     ; 输出最后的0
00C4,12 00 74,,    LCALL DELAY_FREQ
00C7,22,,    RET
,,,
,,,;====================================================================
,,,; 4. 正弦波生成子程序 (查表法)
,,,; 逻辑: 查表输出0-255个点
,,,;====================================================================
00C8,,WAVE_SINE,WAVE_SINE:
00C8,90 00 D9,,    MOV DPTR, #SINE_TABLE ; 指向表头
00CB,7E 00,,    MOV R6, #0            ; 计数器 0-255
00CD,,SINE_LOOP,SINE_LOOP:
00CD,EE,,    MOV A, R6
00CE,93,,    MOVC A, @A+DPTR       ; 查表
00CF,F5 80,,    MOV DAC_PORT, A       ; 输出
00D1,12 00 74,,    LCALL DELAY_FREQ
00D4,0E,,    INC R6
00D5,EE,,    MOV A, R6
00D6,70 F5,,    JNZ SINE_LOOP         ; 循环256次
00D8,22,,    RET
,,,
,,,;====================================================================
,,,; 正弦波数据表 (0-360度，256个采样点，幅值0-255)
,,,; y = 128 + 127 * sin(x)
,,,;====================================================================
00D9,,SINE_TABLE,SINE_TABLE:
00D9,80 83 86 89,,    DB 128, 131, 134, 137, 140, 143, 146, 149, 152, 155, 158, 162, 165, 168, 171, 174
00E9,B0 B3 B6 B9,,    DB 176, 179, 182, 185, 188, 191, 193, 196, 199, 201, 204, 206, 209, 211, 213, 216
00F9,DA DC DE E0,,    DB 218, 220, 222, 224, 226, 228, 230, 232, 234, 236, 237, 239, 240, 242, 243, 245
0109,F6 F7 F8 F9,,    DB 246, 247, 248, 249, 250, 251, 252, 252, 253, 254, 254, 255, 255, 255, 255, 255
0119,FF FF FF FF,,    DB 255, 255, 255, 255, 255, 255, 254, 254, 253, 252, 252, 251, 250, 249, 248, 247
0129,F6 F5 F3 F2,,    DB 246, 245, 243, 242, 240, 239, 237, 236, 234, 232, 230, 228, 226, 224, 222, 220
0139,DA D8 D5 D3,,    DB 218, 216, 213, 211, 209, 206, 204, 201, 199, 196, 193, 191, 188, 185, 182, 179
0149,B0 AE AB A8,,    DB 176, 174, 171, 168, 165, 162, 158, 155, 152, 149, 146, 143, 140, 137, 134, 131
0159,80 7D 7A 77,,    DB 128, 125, 122, 119, 116, 113, 110, 107, 104, 101,  98,  94,  91,  88,  85,  82
0169,50 4D 4A 47,,    DB  80,  77,  74,  71,  68,  65,  63,  60,  57,  55,  52,  50,  47,  45,  43,  40
0179,26 24 22 20,,    DB  38,  36,  34,  32,  30,  28,  26,  24,  22,  20,  19,  17,  16,  14,  13,  11
0189,0A 09 08 07,,    DB  10,   9,   8,   7,   6,   5,   4,   4,   3,   2,   2,   1,   1,   1,   1,   1
0199,01 01 01 01,,    DB   1,   1,   1,   1,   1,   1,   2,   2,   3,   4,   4,   5,   6,   7,   8,   9
01A9,0A 0B 0D 0E,,    DB  10,  11,  13,  14,  16,  17,  19,  20,  22,  24,  26,  28,  30,  32,  34,  36
01B9,26 28 2B 2D,,    DB  38,  40,  43,  45,  47,  50,  52,  55,  57,  60,  63,  65,  68,  71,  74,  77
01C9,50 52 55 58,,    DB  80,  82,  85,  88,  91,  94,  98, 101, 104, 107, 110, 113, 116, 119, 122, 125
,,,
000E,,,    END
