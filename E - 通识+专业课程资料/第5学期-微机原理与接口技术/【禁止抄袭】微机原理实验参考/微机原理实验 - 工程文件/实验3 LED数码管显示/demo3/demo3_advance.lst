 Line  I  Addr  Code            Source

   44:	  0053	22		    RET
   45:
   46:				;--------------------------------------------------------------------
   47:				; 子程序：显示扫描与按键检测
   48:				;--------------------------------------------------------------------
   49:	  0054			DISPLAY_SCAN:
   50:	  0054	78 30		    MOV R0, #DISP_BUF       ; R0指向缓冲区
   51:	  0056	79 FE		    MOV R1, #0FEH           ; 位扫描初值 (1111 1110)
   52:	  0058	7A 00		    MOV R2, #0              ; 键号计数器 (0-7)
   53:
   54:	  005A			SCAN_LOOP:
   55:				    ; 1. 送位选码 (选择哪一位显示，同时拉低对应的按键列线)
   56:	  005A	89 A0		    MOV P2, R1              ; 【修改】数据送 P2 口
   57:	  005C	D2 B1		    SETB BIT_LE             ; 打开位锁存
   58:	  005E	C2 B1		    CLR  BIT_LE             ; 锁存位码
   59:
   60:				    ; 2. 按键检测 (检测 P3.2 是否被当前列的低电平拉低)
   61:	  0060	20 B2 0C	    JB KEY_IN, NO_KEY       ; 若 P3.2 为高，说明无键按下，跳过
   62:
   63:				    ; --- 按键处理 ---
   64:	  0063	12 00 E3	    CALL DELAY_SMALL        ; 消抖
   65:	  0066	20 B2 06	    JB KEY_IN, NO_KEY       ; 再次确认
   66:
   67:	  0069	12 00 8D	    CALL SHIFT_DISPLAY      ; 移位并存入新键号(R2)
   68:	  006C	12 00 A5	    CALL WAIT_KEY_UP        ; 等待按键释放
   69:				    ; ---------------
   70:
   71:	  006F			NO_KEY:
   72:				    ; 3. 送段选码 (显示字符)
   73:	  006F	E6		    MOV A, @R0              ; 取显示内容索引
   74:	  0070	90 00 EC	    MOV DPTR, #SEG_TABLE    ; 查表
   75:	  0073	93		    MOVC A, @A+DPTR
   76:	  0074	F5 A0		    MOV P2, A               ; 【修改】数据送 P2 口
   77:	  0076	D2 B0		    SETB SEG_LE             ; 打开段锁存
   78:	  0078	C2 B0		    CLR  SEG_LE             ; 锁存段码
   79:
   80:				    ; 4. 延时显示
   81:	  007A	12 00 DE	    CALL DELAY_SCAN
   82:
   83:				    ; 5. 消隐 (防止拖影)
   84:	  007D	75 A0 00	    MOV P2, #00H            ; 【修改】关断所有段
   85:	  0080	D2 B0		    SETB SEG_LE
   86:	  0082	C2 B0		    CLR  SEG_LE
   87:
   88:				    ; 6. 准备下一位
   89:	  0084	08		    INC R0                  ; 指向下一个显存单元
   90:	  0085	E9		    MOV A, R1
   91:	  0086	23		    RL A                    ; 位码左移
   92:	  0087	F9		    MOV R1, A
   93:	  0088	0A		    INC R2                  ; 键号加1
   94:
   95:	  0089	BA 08 CE	    CJNE R2, #8, SCAN_LOOP  ; 扫完8位则结束
   96:	  008C	22		    RET
   97:
   98:				;--------------------------------------------------------------------
   99:				; 子程序：移位处理

