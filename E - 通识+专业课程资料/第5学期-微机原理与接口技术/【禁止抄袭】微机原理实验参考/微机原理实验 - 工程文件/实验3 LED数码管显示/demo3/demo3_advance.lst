  156:	  00D7			WAIT_EXIT:
  157:	  00D7	D0 02		    POP 02H
  158:	  00D9	D0 01		    POP 01H
  159:	  00DB	D0 00		    POP 00H
  160:	  00DD	22		    RET
  161:
  162:				;--------------------------------------------------------------------
  163:				; 延时子程序
  164:				;--------------------------------------------------------------------
  165:	  00DE			DELAY_SCAN:                 ; 扫描延时 (~1ms)
  166:	  00DE	7B C8		    MOV R3, #200
  167:	  00E0	DB FE		    DJNZ R3, $
  168:	  00E2	22		    RET
  169:
  170:	  00E3			DELAY_SMALL:                ; 消抖延时 (~10ms)
  171:	  00E3	7B 14		    MOV R3, #20
  172:	  00E5	7C F8		D1: MOV R4, #248
  173:	  00E7	DC FE		    DJNZ R4, $
  174:	  00E9	DB FA		    DJNZ R3, D1
  175:	  00EB	22		    RET
  176:
  177:				;--------------------------------------------------------------------
  178:				; 段码表 (共阴极)
  179:				;--------------------------------------------------------------------
  180:	  00EC			SEG_TABLE:
  181:	  00EC	3F		    DB 3FH  ; 0
  182:	  00ED	06		    DB 06H  ; 1
  183:	  00EE	5B		    DB 5BH  ; 2
  184:	  00EF	4F		    DB 4FH  ; 3
  185:	  00F0	66		    DB 66H  ; 4
  186:	  00F1	6D		    DB 6DH  ; 5
  187:	  00F2	7D		    DB 7DH  ; 6
  188:	  00F3	07		    DB 07H  ; 7
  189:	  00F4	7F		    DB 7FH  ; 8
  190:	  00F5	6F		    DB 6FH  ; 9
  191:	  00F6	76		    DB 76H  ; 10 (H)
  192:	  00F7	79		    DB 79H  ; 11 (E)
  193:	  00F8	38		    DB 38H  ; 12 (L)
  194:	  00F9	40		    DB 40H  ; 13 (-)
  195:	  00FA	00		    DB 00H  ; 14 (空格)
