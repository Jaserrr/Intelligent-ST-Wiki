 Line  I  Addr  Code            Source

  100:				; 功能：缓冲区左移，新键值 R2 存入最右侧 (37H)
  101:				;--------------------------------------------------------------------
  102:	  008D			SHIFT_DISPLAY:
  103:	  008D	85 31 30	    MOV 30H, 31H
  104:	  0090	85 32 31	    MOV 31H, 32H
  105:	  0093	85 33 32	    MOV 32H, 33H
  106:	  0096	85 34 33	    MOV 33H, 34H
  107:	  0099	85 35 34	    MOV 34H, 35H
  108:	  009C	85 36 35	    MOV 35H, 36H
  109:	  009F	85 37 36	    MOV 36H, 37H
  110:	  00A2	8A 37		    MOV 37H, R2             ; 新按键值存入最后一位
  111:	  00A4	22		    RET
  112:
  113:				;--------------------------------------------------------------------
  114:				; 子程序：等待按键释放
  115:				; 等待过程中必须持续刷新显示，否则数码管会闪烁或熄灭
  116:				;--------------------------------------------------------------------
  117:	  00A5			WAIT_KEY_UP:
  118:	  00A5	C0 00		    PUSH 00H
  119:	  00A7	C0 01		    PUSH 01H
  120:	  00A9	C0 02		    PUSH 02H
  121:
  122:	  00AB			WAIT_LOOP:
  123:	  00AB	20 B2 29	    JB KEY_IN, WAIT_EXIT    ; 按键释放(变为高电平)则退出
  124:
  125:				    ; 简单的显示刷新循环 (不检测按键)
  126:	  00AE	78 30		    MOV R0, #DISP_BUF
  127:	  00B0	79 FE		    MOV R1, #0FEH
  128:	  00B2	7A 08		    MOV R2, #8
  129:	  00B4			REFRESH_LOOP:
  130:				    ; 送位
  131:	  00B4	89 A0		    MOV P2, R1              ; 【修改】P2
  132:	  00B6	D2 B1		    SETB BIT_LE
  133:	  00B8	C2 B1		    CLR  BIT_LE
  134:				    ; 送段
  135:	  00BA	E6		    MOV A, @R0
  136:	  00BB	90 00 EC	    MOV DPTR, #SEG_TABLE
  137:	  00BE	93		    MOVC A, @A+DPTR
  138:	  00BF	F5 A0		    MOV P2, A               ; 【修改】P2
  139:	  00C1	D2 B0		    SETB SEG_LE
  140:	  00C3	C2 B0		    CLR  SEG_LE
  141:				    ; 延时
  142:	  00C5	12 00 DE	    CALL DELAY_SCAN
  143:				    ; 消隐
  144:	  00C8	75 A0 00	    MOV P2, #00H            ; 【修改】P2
  145:	  00CB	D2 B0		    SETB SEG_LE
  146:	  00CD	C2 B0		    CLR  SEG_LE
  147:				    ; 下一位
  148:	  00CF	08		    INC R0
  149:	  00D0	E9		    MOV A, R1
  150:	  00D1	23		    RL A
  151:	  00D2	F9		    MOV R1, A
  152:	  00D3	DA DF		    DJNZ R2, REFRESH_LOOP
  153:
  154:	  00D5	80 D4		    SJMP WAIT_LOOP
  155:

