 Line  I  Addr  Code            Source

    1:				;====================================================================
    2:				; 实验名称：LED数码管显示与按钮输入 (修正版)
    3:				; 硬件映射：
    4:				;   数据总线：P2.0 - P2.7  -> 接 74HC573 输入 (D0-D7)
    5:				;   段选控制：P3.0         -> 接 段码锁存器 LE (上方的573)
    6:				;   位选控制：P3.1         -> 接 位码锁存器 LE (下方的573)
    7:				;   按键输入：P3.2         -> 接 按钮公共端 (INT0)
    8:				;====================================================================
    9:
   10:				;--- 定义变量与引脚 ---
   11:		B	 B0	SEG_LE      BIT P3.0        ; 段锁存使能 (根据原理图修改)
   12:		B	 B1	BIT_LE      BIT P3.1        ; 位锁存使能 (根据原理图修改)
   13:		B	 B2	KEY_IN      BIT P3.2        ; 按键输入
   14:
   15:		N      0030	DISP_BUF    EQU 30H         ; 显示缓冲区起始地址 (30H-37H)
   16:
   17:				;--- 程序入口 ---
   18:		N      0000	ORG 0000H
   19:	  0000	02 00 30	    LJMP MAIN
   20:
   21:				;--- 主程序 ---
   22:		N      0030	ORG 0030H
   23:	  0030			MAIN:
   24:	  0030	75 81 60	    MOV SP, #60H            ; 初始化堆栈
   25:	  0033	12 00 3B	    CALL INIT_BUFFER        ; 初始化显示内容 "HELLO-- "
   26:
   27:	  0036			MAIN_LOOP:
   28:	  0036	12 00 54	    CALL DISPLAY_SCAN       ; 循环调用扫描
   29:	  0039	80 FB		    SJMP MAIN_LOOP
   30:
   31:				;--------------------------------------------------------------------
   32:				; 子程序：初始化显示缓冲区
   33:				; 内容：H E L L O - - (空格)
   34:				;--------------------------------------------------------------------
   35:	  003B			INIT_BUFFER:
   36:	  003B	75 30 0A	    MOV 30H, #10            ; H
   37:	  003E	75 31 0B	    MOV 31H, #11            ; E
   38:	  0041	75 32 0C	    MOV 32H, #12            ; L
   39:	  0044	75 33 0C	    MOV 33H, #12            ; L
   40:	  0047	75 34 00	    MOV 34H, #00            ; O (用0代替)
   41:	  004A	75 35 0D	    MOV 35H, #13            ; -
   42:	  004D	75 36 0D	    MOV 36H, #13            ; -
   43:	  0050	75 37 0E	    MOV 37H, #14            ; 空格

