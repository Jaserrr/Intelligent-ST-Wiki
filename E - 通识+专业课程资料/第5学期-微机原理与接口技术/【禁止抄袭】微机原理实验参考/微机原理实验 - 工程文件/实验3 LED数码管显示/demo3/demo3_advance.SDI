,,,;====================================================================
,,,; 实验名称：LED数码管显示与按钮输入 (修正版)
,,,; 硬件映射：
,,,;   数据总线：P2.0 - P2.7  -> 接 74HC573 输入 (D0-D7)
,,,;   段选控制：P3.0         -> 接 段码锁存器 LE (上方的573)
,,,;   位选控制：P3.1         -> 接 位码锁存器 LE (下方的573)
,,,;   按键输入：P3.2         -> 接 按钮公共端 (INT0)
,,,;====================================================================
,,,
,,,;--- 定义变量与引脚 ---
000B,,,SEG_LE      BIT P3.0        ; 段锁存使能 (根据原理图修改)
000B,,,BIT_LE      BIT P3.1        ; 位锁存使能 (根据原理图修改)
000B,,,KEY_IN      BIT P3.2        ; 按键输入
,,,
,,,DISP_BUF    EQU 30H         ; 显示缓冲区起始地址 (30H-37H)
,,,
,,,;--- 程序入口 ---
,,,ORG 0000H
0000,02 00 30,,    LJMP MAIN
,,,
,,,;--- 主程序 ---
,,,ORG 0030H
0030,,MAIN,MAIN:
0030,75 81 60,,    MOV SP, #60H            ; 初始化堆栈
0033,12 00 3B,,    CALL INIT_BUFFER        ; 初始化显示内容 "HELLO-- "
,,,
0036,,MAIN_LOOP,MAIN_LOOP:
0036,12 00 54,,    CALL DISPLAY_SCAN       ; 循环调用扫描
0039,80 FB,,    SJMP MAIN_LOOP
,,,
,,,;--------------------------------------------------------------------
,,,; 子程序：初始化显示缓冲区
,,,; 内容：H E L L O - - (空格)
,,,;--------------------------------------------------------------------
003B,,INIT_BUFFER,INIT_BUFFER:
003B,75 30 0A,,    MOV 30H, #10            ; H
003E,75 31 0B,,    MOV 31H, #11            ; E
0041,75 32 0C,,    MOV 32H, #12            ; L
0044,75 33 0C,,    MOV 33H, #12            ; L
0047,75 34 00,,    MOV 34H, #00            ; O (用0代替)
004A,75 35 0D,,    MOV 35H, #13            ; -
004D,75 36 0D,,    MOV 36H, #13            ; -
0050,75 37 0E,,    MOV 37H, #14            ; 空格
0053,22,,    RET
,,,
,,,;--------------------------------------------------------------------
,,,; 子程序：显示扫描与按键检测
,,,;--------------------------------------------------------------------
0054,,DISPLAY_SCAN,DISPLAY_SCAN:
0054,78 30,,    MOV R0, #DISP_BUF       ; R0指向缓冲区
0056,79 FE,,    MOV R1, #0FEH           ; 位扫描初值 (1111 1110)
0058,7A 00,,    MOV R2, #0              ; 键号计数器 (0-7)
,,,
005A,,SCAN_LOOP,SCAN_LOOP:
,,,    ; 1. 送位选码 (选择哪一位显示，同时拉低对应的按键列线)
005A,89 A0,,    MOV P2, R1              ; 【修改】数据送 P2 口
005C,D2 B1,,    SETB BIT_LE             ; 打开位锁存
005E,C2 B1,,    CLR  BIT_LE             ; 锁存位码
,,,
,,,    ; 2. 按键检测 (检测 P3.2 是否被当前列的低电平拉低)
0060,20 B2 0C,,    JB KEY_IN, NO_KEY       ; 若 P3.2 为高，说明无键按下，跳过
,,,
,,,    ; --- 按键处理 ---
0063,12 00 E3,,    CALL DELAY_SMALL        ; 消抖
0066,20 B2 06,,    JB KEY_IN, NO_KEY       ; 再次确认
,,,
0069,12 00 8D,,    CALL SHIFT_DISPLAY      ; 移位并存入新键号(R2)
006C,12 00 A5,,    CALL WAIT_KEY_UP        ; 等待按键释放
,,,    ; ---------------
,,,
006F,,NO_KEY,NO_KEY:
,,,    ; 3. 送段选码 (显示字符)
006F,E6,,    MOV A, @R0              ; 取显示内容索引
0070,90 00 EC,,    MOV DPTR, #SEG_TABLE    ; 查表
0073,93,,    MOVC A, @A+DPTR
0074,F5 A0,,    MOV P2, A               ; 【修改】数据送 P2 口
0076,D2 B0,,    SETB SEG_LE             ; 打开段锁存
0078,C2 B0,,    CLR  SEG_LE             ; 锁存段码
,,,
,,,    ; 4. 延时显示
007A,12 00 DE,,    CALL DELAY_SCAN
,,,
,,,    ; 5. 消隐 (防止拖影)
007D,75 A0 00,,    MOV P2, #00H            ; 【修改】关断所有段
0080,D2 B0,,    SETB SEG_LE
0082,C2 B0,,    CLR  SEG_LE
,,,
,,,    ; 6. 准备下一位
0084,08,,    INC R0                  ; 指向下一个显存单元
0085,E9,,    MOV A, R1
0086,23,,    RL A                    ; 位码左移
0087,F9,,    MOV R1, A
0088,0A,,    INC R2                  ; 键号加1
,,,
0089,BA 08 CE,,    CJNE R2, #8, SCAN_LOOP  ; 扫完8位则结束
008C,22,,    RET
,,,
,,,;--------------------------------------------------------------------
,,,; 子程序：移位处理
,,,; 功能：缓冲区左移，新键值 R2 存入最右侧 (37H)
,,,;--------------------------------------------------------------------
008D,,SHIFT_DISPLAY,SHIFT_DISPLAY:
008D,85 31 30,,    MOV 30H, 31H
0090,85 32 31,,    MOV 31H, 32H
0093,85 33 32,,    MOV 32H, 33H
0096,85 34 33,,    MOV 33H, 34H
0099,85 35 34,,    MOV 34H, 35H
009C,85 36 35,,    MOV 35H, 36H
009F,85 37 36,,    MOV 36H, 37H
00A2,8A 37,,    MOV 37H, R2             ; 新按键值存入最后一位
00A4,22,,    RET
,,,
,,,;--------------------------------------------------------------------
,,,; 子程序：等待按键释放
,,,; 等待过程中必须持续刷新显示，否则数码管会闪烁或熄灭
,,,;--------------------------------------------------------------------
00A5,,WAIT_KEY_UP,WAIT_KEY_UP:
00A5,C0 00,,    PUSH 00H
00A7,C0 01,,    PUSH 01H
00A9,C0 02,,    PUSH 02H
,,,
00AB,,WAIT_LOOP,WAIT_LOOP:
00AB,20 B2 29,,    JB KEY_IN, WAIT_EXIT    ; 按键释放(变为高电平)则退出
,,,
,,,    ; 简单的显示刷新循环 (不检测按键)
00AE,78 30,,    MOV R0, #DISP_BUF
00B0,79 FE,,    MOV R1, #0FEH
00B2,7A 08,,    MOV R2, #8
00B4,,REFRESH_LOOP,REFRESH_LOOP:
,,,    ; 送位
00B4,89 A0,,    MOV P2, R1              ; 【修改】P2
00B6,D2 B1,,    SETB BIT_LE
00B8,C2 B1,,    CLR  BIT_LE
,,,    ; 送段
00BA,E6,,    MOV A, @R0
00BB,90 00 EC,,    MOV DPTR, #SEG_TABLE
00BE,93,,    MOVC A, @A+DPTR
00BF,F5 A0,,    MOV P2, A               ; 【修改】P2
00C1,D2 B0,,    SETB SEG_LE
00C3,C2 B0,,    CLR  SEG_LE
,,,    ; 延时
00C5,12 00 DE,,    CALL DELAY_SCAN
,,,    ; 消隐
00C8,75 A0 00,,    MOV P2, #00H            ; 【修改】P2
00CB,D2 B0,,    SETB SEG_LE
00CD,C2 B0,,    CLR  SEG_LE
,,,    ; 下一位
00CF,08,,    INC R0
00D0,E9,,    MOV A, R1
00D1,23,,    RL A
00D2,F9,,    MOV R1, A
00D3,DA DF,,    DJNZ R2, REFRESH_LOOP
,,,
00D5,80 D4,,    SJMP WAIT_LOOP
,,,
00D7,,WAIT_EXIT,WAIT_EXIT:
00D7,D0 02,,    POP 02H
00D9,D0 01,,    POP 01H
00DB,D0 00,,    POP 00H
00DD,22,,    RET
,,,
,,,;--------------------------------------------------------------------
,,,; 延时子程序
,,,;--------------------------------------------------------------------
00DE,,DELAY_SCAN,DELAY_SCAN:                 ; 扫描延时 (~1ms)
00DE,7B C8,,    MOV R3, #200
00E0,DB FE,,    DJNZ R3, $
00E2,22,,    RET
,,,
00E3,,DELAY_SMALL,DELAY_SMALL:                ; 消抖延时 (~10ms)
00E3,7B 14,,    MOV R3, #20
00E5,7C F8,D1,D1: MOV R4, #248
00E7,DC FE,,    DJNZ R4, $
00E9,DB FA,,    DJNZ R3, D1
00EB,22,,    RET
,,,
,,,;--------------------------------------------------------------------
,,,; 段码表 (共阴极)
,,,;--------------------------------------------------------------------
00EC,,SEG_TABLE,SEG_TABLE:
00EC,3F,,    DB 3FH  ; 0
00ED,06,,    DB 06H  ; 1
00EE,5B,,    DB 5BH  ; 2
00EF,4F,,    DB 4FH  ; 3
00F0,66,,    DB 66H  ; 4
00F1,6D,,    DB 6DH  ; 5
00F2,7D,,    DB 7DH  ; 6
00F3,07,,    DB 07H  ; 7
00F4,7F,,    DB 7FH  ; 8
00F5,6F,,    DB 6FH  ; 9
00F6,76,,    DB 76H  ; 10 (H)
00F7,79,,    DB 79H  ; 11 (E)
00F8,38,,    DB 38H  ; 12 (L)
00F9,40,,    DB 40H  ; 13 (-)
00FA,00,,    DB 00H  ; 14 (空格)
,,,
000E,,,END
