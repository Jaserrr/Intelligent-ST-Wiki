       MCS-51 Family Macro Assembler   A S E M - 5 1   V 1.3
       =====================================================



	Source File:	switch.ASM
	Object File:	switch.hex
	List File:	switch.lst



 Line  I  Addr  Code            Source

    1:		N      0000	ORG 0000H
    2:	  0000	02 01 00	LJMP MAIN  ; 跳转到主程序
    3:
    4:		N      0100	ORG 0100H
    5:	  0100			MAIN:
    6:	  0100	78 08		MOV R0, #08H  ; 循环8次（覆盖P1.0~P1.7共8个LED）
    7:	  0102	74 FE		MOV A, #0FEH  ; 初始值：二进制11111110 → P1.0=0（亮），P1.1~P1.7=1（灭）
    8:
    9:	  0104			LOOP:
   10:	  0104	F5 90		MOV P1, A     ; 将电平状态输出到P1口（控制LED）
   11:	  0106	12 01 0E	LCALL DELAY   ; 延时保持当前亮灯状态
   12:	  0109	23		RL A          ; 左移指令：低电平（亮灯）从P1.0→P1.1→...→P1.7移动
   13:	  010A	D8 F8		DJNZ R0, LOOP ; 循环次数减1，未到8次则继续
   14:	  010C	80 F2		SJMP MAIN     ; 循环完成后重新开始，往复执行
   15:
   16:				; 延时函数（数值越小，速度越快）
   17:	  010E			DELAY:
   18:	  010E	7F 1F		MOV R7, #1FH  ; 外层循环次数（控制总延时）
   19:	  0110			DELAY0:
   20:	  0110	7E 3F		MOV R6, #3FH  ; 中层循环次数
   21:	  0112			DELAY1:
   22:	  0112	7D 3F		MOV R5, #3FH  ; 内层循环次数
   23:	  0114	DD FE		DJNZ R5, $    ; 内层空循环（消耗时间）
   24:	  0116	DE FA		DJNZ R6, DELAY1
   25:	  0118	DF F6		DJNZ R7, DELAY0
   26:	  011A	22		RET
   27:
   28:				END





                     register banks used:  ---

                     no errors




