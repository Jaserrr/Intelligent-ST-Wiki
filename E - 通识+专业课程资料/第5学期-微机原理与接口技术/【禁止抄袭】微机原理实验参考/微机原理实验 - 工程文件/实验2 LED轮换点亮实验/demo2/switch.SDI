,,,ORG 0000H
0000,02 01 00,,LJMP MAIN  ; 跳转到主程序
,,,
,,,ORG 0100H
0100,,MAIN,MAIN:
0100,78 08,,MOV R0, #08H  ; 循环8次（覆盖P1.0~P1.7共8个LED）
0102,74 FE,,MOV A, #0FEH  ; 初始值：二进制11111110 → P1.0=0（亮），P1.1~P1.7=1（灭）
,,,
0104,,LOOP,LOOP:
0104,F5 90,,MOV P1, A     ; 将电平状态输出到P1口（控制LED）
0106,12 01 0E,,LCALL DELAY   ; 延时保持当前亮灯状态
0109,23,,RL A          ; 左移指令：低电平（亮灯）从P1.0→P1.1→...→P1.7移动
010A,D8 F8,,DJNZ R0, LOOP ; 循环次数减1，未到8次则继续
010C,80 F2,,SJMP MAIN     ; 循环完成后重新开始，往复执行
,,,
,,,; 延时函数（数值越小，速度越快）
010E,,DELAY,DELAY:
010E,7F 1F,,MOV R7, #1FH  ; 外层循环次数（控制总延时）
0110,,DELAY0,DELAY0:
0110,7E 3F,,MOV R6, #3FH  ; 中层循环次数
0112,,DELAY1,DELAY1:
0112,7D 3F,,MOV R5, #3FH  ; 内层循环次数
0114,DD FE,,DJNZ R5, $    ; 内层空循环（消耗时间）
0116,DE FA,,DJNZ R6, DELAY1
0118,DF F6,,DJNZ R7, DELAY0
011A,22,,RET
,,,
000E,,,END
