 Line  I  Addr  Code            Source

  100:	  0080	F5 30		    MOV CNT_LL, A   ; 存回
  101:
  102:	  0082	B4 64 24	    CJNE A, #100, T1_EXIT ; 如果不等于100 (即0-99), 退出
  103:
  104:				    ; --- 进位处理 1 ---
  105:	  0085	75 30 00	    MOV CNT_LL, #0  ; 清零最低2位
  106:
  107:	  0088	E5 31		    MOV A, CNT_LH   ; 取次低2位
  108:	  008A	04		    INC A
  109:	  008B	F5 31		    MOV CNT_LH, A
  110:	  008D	B4 64 19	    CJNE A, #100, T1_EXIT ; 判断是否满100
  111:
  112:				    ; --- 进位处理 2 ---
  113:	  0090	75 31 00	    MOV CNT_LH, #0  ; 清零
  114:
  115:	  0093	E5 32		    MOV A, CNT_HL   ; 取次高2位
  116:	  0095	04		    INC A
  117:	  0096	F5 32		    MOV CNT_HL, A
  118:	  0098	B4 64 0E	    CJNE A, #100, T1_EXIT
  119:
  120:				    ; --- 进位处理 3 ---
  121:	  009B	75 32 00	    MOV CNT_HL, #0  ; 清零
  122:
  123:	  009E	E5 33		    MOV A, CNT_HH   ; 取最高2位
  124:	  00A0	04		    INC A
  125:	  00A1	F5 33		    MOV CNT_HH, A
  126:	  00A3	B4 64 03	    CJNE A, #100, T1_EXIT
  127:
  128:				    ; --- 溢出归零 (虽然很少发生) ---
  129:	  00A6	75 33 00	    MOV CNT_HH, #0
  130:
  131:	  00A9			T1_EXIT:
  132:	  00A9	D0 E0		    POP ACC         ; 恢复现场
  133:	  00AB	D0 D0		    POP PSW
  134:	  00AD	32		    RETI
  135:
  136:	  00AE			DISPLAY_ALL:
  137:				    ; 显示第8位 (最高位千万位) - 对应 CNT_HH 的十位
  138:	  00AE	E5 33		    MOV A, CNT_HH
  139:	  00B0	75 F0 0A	    MOV B, #10
  140:	  00B3	84		    DIV AB          ; A = 十位, B = 个位
  141:	  00B4	90 01 3A	    MOV DPTR, #TAB
  142:	  00B7	93		    MOVC A, @A+DPTR ; 查表得段码
  143:	  00B8	75 80 00	    MOV P0, #00H    ; 消隐
  144:	  00BB	75 A0 FE	    MOV P2, #0FEH   ; 选中第1位 (1111 1110)
  145:	  00BE	F5 80		    MOV P0, A       ; 输出段码
  146:	  00C0	12 01 35	    LCALL DELAY     ; 延时
  147:
  148:				    ; 显示第7位 (百万位) - 对应 CNT_HH 的个位
  149:	  00C3	E5 F0		    MOV A, B        ; 取刚才DIV剩下的余数(个位)
  150:	  00C5	93		    MOVC A, @A+DPTR
  151:	  00C6	75 80 00	    MOV P0, #00H
  152:	  00C9	75 A0 FD	    MOV P2, #0FDH   ; 选中第2位 (1111 1101)
  153:	  00CC	F5 80		    MOV P0, A
  154:	  00CE	12 01 35	    LCALL DELAY
  155:

