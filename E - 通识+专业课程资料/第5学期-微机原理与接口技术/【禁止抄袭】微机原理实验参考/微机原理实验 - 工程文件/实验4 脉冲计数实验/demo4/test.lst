 Line  I  Addr  Code            Source

    1:				; 定义变量存储单元 (4个字节对应8位十进制数)
    2:				; 每个字节存储 0-99 的数值
    3:		N      0030	CNT_LL  EQU 30H    ; 最低2位 (个位, 十位)
    4:		N      0031	CNT_LH  EQU 31H    ; 次低2位 (百位, 千位)
    5:		N      0032	CNT_HL  EQU 32H    ; 次高2位 (万位, 十万位)
    6:		N      0033	CNT_HH  EQU 33H    ; 最高2位 (百万位, 千万位)
    7:
    8:				; 复位入口
    9:		N      0000	ORG 0000H
   10:	  0000	02 00 30	    LJMP MAIN       ; 上电跳转到主程序
   11:
   12:				; 中断向量表
   13:		N      0003	ORG 0003H           ; 外部中断0入口 (启动/暂停)
   14:	  0003	02 00 5F	    LJMP ISR_INT0
   15:
   16:		N      0013	ORG 0013H           ; 外部中断1入口 (清零)
   17:	  0013	02 00 62	    LJMP ISR_INT1
   18:
   19:		N      001B	ORG 001BH           ; 定时器1中断入口 (脉冲计数)
   20:	  001B	02 00 74	    LJMP ISR_T1
   21:
   22:				;-------------------------主程序-------------------------
   23:		N      0030	ORG 0030H
   24:	  0030			MAIN:
   25:				    ; 1. 堆栈初始化
   26:	  0030	75 81 60	    MOV SP, #60H
   27:
   28:				    ; 2. 变量初始化 (清零显示)
   29:	  0033	75 30 00	    MOV CNT_LL, #0
   30:	  0036	75 31 00	    MOV CNT_LH, #0
   31:	  0039	75 32 00	    MOV CNT_HL, #0
   32:	  003C	75 33 00	    MOV CNT_HH, #0
   33:
   34:				    ; 3. 定时器T1配置 (设计提示2)
   35:				    ; TMOD: Gate=0, C/T=1(计数), M1=1, M0=0 (方式2: 8位自动重装)
   36:				    ; 高4位控制T1, 低4位控制T0. 二进制: 0110 0000
   37:	  003F	75 89 60	    MOV TMOD, #60H
   38:
   39:				    ; 设置初值为0xFF, 只要来1个脉冲就溢出中断
   40:	  0042	75 8D FF	    MOV TH1, #0FFH
   41:	  0045	75 8B FF	    MOV TL1, #0FFH
   42:
   43:				    ; 4. 中断配置

