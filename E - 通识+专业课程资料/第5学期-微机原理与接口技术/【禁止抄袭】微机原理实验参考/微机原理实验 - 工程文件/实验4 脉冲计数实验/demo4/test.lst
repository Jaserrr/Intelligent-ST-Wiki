 Line  I  Addr  Code            Source

   44:	  0048	D2 AF		    SETB EA         ; 开总中断
   45:	  004A	D2 AB		    SETB ET1        ; 开定时器1中断
   46:	  004C	D2 A8		    SETB EX0        ; 开外部中断0
   47:	  004E	D2 AA		    SETB EX1        ; 开外部中断1
   48:
   49:				    ; 设置触发方式为下降沿 (ITx = 1)
   50:	  0050	D2 88		    SETB IT0
   51:	  0052	D2 8A		    SETB IT1
   52:
   53:				    ; 设置外部中断优先级为高 (设计提示1)
   54:	  0054	D2 B8		    SETB PX0
   55:	  0056	D2 BA		    SETB PX1
   56:
   57:				    ; 5. 初始状态: 停止计数
   58:	  0058	C2 8E		    CLR TR1         ; TR1=0 停止, TR1=1 开始
   59:
   60:				; 主循环: 负责数码管动态扫描显示
   61:	  005A			LOOP:
   62:	  005A	12 00 AE	    LCALL DISPLAY_ALL
   63:	  005D	80 FB		    SJMP LOOP
   64:
   65:				; 中断服务程序
   66:
   67:				; 外部中断0 (启动/暂停)
   68:	  005F			ISR_INT0:
   69:	  005F	B2 8E		    CPL TR1         ; 取反TR1位: 运行->暂停, 暂停->运行
   70:	  0061	32		    RETI
   71:
   72:				; 外部中断1 (清零)
   73:	  0062			ISR_INT1:
   74:	  0062	C2 8E		    CLR TR1         ; 停止计数
   75:				    ; 清除所有计数值
   76:	  0064	75 30 00	    MOV CNT_LL, #0
   77:	  0067	75 31 00	    MOV CNT_LH, #0
   78:	  006A	75 32 00	    MOV CNT_HL, #0
   79:	  006D	75 33 00	    MOV CNT_HH, #0
   80:				    ; 恢复T1初值 (保险起见)
   81:	  0070	75 8B FF	    MOV TL1, #0FFH
   82:	  0073	32		    RETI
   83:
   84:				;--------------------------------------------------------------------
   85:				; 定时器1中断 (脉冲计数核心逻辑)
   86:				; 逻辑参考流程图: 多字节十进制加1
   87:				;--------------------------------------------------------------------
   88:	  0074			ISR_T1:
   89:	  0074	C0 D0		    PUSH PSW        ; 保护现场
   90:	  0076	C0 E0		    PUSH ACC
   91:
   92:				    ; --- 最低2位加1 ---
   93:	  0078	E5 30		    MOV A, CNT_LL
   94:	  007A	24 01		    ADD A, #1       ; 加1
   95:	  007C	D4		    DA A            ; BCD调整(虽然存储的是HEX值0-99, 但逻辑上我们需要判100)
   96:				                    ; 注意: 这里直接用HEX判断更简单, 因为DA A是针对BCD运算的
   97:				                    ; 按照题目流程图逻辑：
   98:	  007D	E5 30		    MOV A, CNT_LL
   99:	  007F	04		    INC A           ; 寄存器值加1

