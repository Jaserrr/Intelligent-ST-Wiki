,,,; 定义变量存储单元 (4个字节对应8位十进制数)
,,,; 每个字节存储 0-99 的数值
,,,CNT_LL  EQU 30H    ; 最低2位 (个位, 十位)
,,,CNT_LH  EQU 31H    ; 次低2位 (百位, 千位)
,,,CNT_HL  EQU 32H    ; 次高2位 (万位, 十万位)
,,,CNT_HH  EQU 33H    ; 最高2位 (百万位, 千万位)
,,,
,,,; 复位入口
,,,ORG 0000H
0000,02 00 30,,    LJMP MAIN       ; 上电跳转到主程序
,,,
,,,; 中断向量表
,,,ORG 0003H           ; 外部中断0入口 (启动/暂停)
0003,02 00 5F,,    LJMP ISR_INT0
,,,
,,,ORG 0013H           ; 外部中断1入口 (清零)
0013,02 00 62,,    LJMP ISR_INT1
,,,
,,,ORG 001BH           ; 定时器1中断入口 (脉冲计数)
001B,02 00 74,,    LJMP ISR_T1
,,,
,,,;-------------------------主程序-------------------------
,,,ORG 0030H
0030,,MAIN,MAIN:
,,,    ; 1. 堆栈初始化
0030,75 81 60,,    MOV SP, #60H
,,,
,,,    ; 2. 变量初始化 (清零显示)
0033,75 30 00,,    MOV CNT_LL, #0
0036,75 31 00,,    MOV CNT_LH, #0
0039,75 32 00,,    MOV CNT_HL, #0
003C,75 33 00,,    MOV CNT_HH, #0
,,,
,,,    ; 3. 定时器T1配置 (设计提示2)
,,,    ; TMOD: Gate=0, C/T=1(计数), M1=1, M0=0 (方式2: 8位自动重装)
,,,    ; 高4位控制T1, 低4位控制T0. 二进制: 0110 0000
003F,75 89 60,,    MOV TMOD, #60H
,,,
,,,    ; 设置初值为0xFF, 只要来1个脉冲就溢出中断
0042,75 8D FF,,    MOV TH1, #0FFH
0045,75 8B FF,,    MOV TL1, #0FFH
,,,
,,,    ; 4. 中断配置
0048,D2 AF,,    SETB EA         ; 开总中断
004A,D2 AB,,    SETB ET1        ; 开定时器1中断
004C,D2 A8,,    SETB EX0        ; 开外部中断0
004E,D2 AA,,    SETB EX1        ; 开外部中断1
,,,
,,,    ; 设置触发方式为下降沿 (ITx = 1)
0050,D2 88,,    SETB IT0
0052,D2 8A,,    SETB IT1
,,,
,,,    ; 设置外部中断优先级为高 (设计提示1)
0054,D2 B8,,    SETB PX0
0056,D2 BA,,    SETB PX1
,,,
,,,    ; 5. 初始状态: 停止计数
0058,C2 8E,,    CLR TR1         ; TR1=0 停止, TR1=1 开始
,,,
,,,; 主循环: 负责数码管动态扫描显示
005A,,LOOP,LOOP:
005A,12 00 AE,,    LCALL DISPLAY_ALL
005D,80 FB,,    SJMP LOOP
,,,
,,,; 中断服务程序
,,,
,,,; 外部中断0 (启动/暂停)
005F,,ISR_INT0,ISR_INT0:
005F,B2 8E,,    CPL TR1         ; 取反TR1位: 运行->暂停, 暂停->运行
0061,32,,    RETI
,,,
,,,; 外部中断1 (清零)
0062,,ISR_INT1,ISR_INT1:
0062,C2 8E,,    CLR TR1         ; 停止计数
,,,    ; 清除所有计数值
0064,75 30 00,,    MOV CNT_LL, #0
0067,75 31 00,,    MOV CNT_LH, #0
006A,75 32 00,,    MOV CNT_HL, #0
006D,75 33 00,,    MOV CNT_HH, #0
,,,    ; 恢复T1初值 (保险起见)
0070,75 8B FF,,    MOV TL1, #0FFH
0073,32,,    RETI
,,,
,,,;--------------------------------------------------------------------
,,,; 定时器1中断 (脉冲计数核心逻辑)
,,,; 逻辑参考流程图: 多字节十进制加1
,,,;--------------------------------------------------------------------
0074,,ISR_T1,ISR_T1:
0074,C0 D0,,    PUSH PSW        ; 保护现场
0076,C0 E0,,    PUSH ACC
,,,
,,,    ; --- 最低2位加1 ---
0078,E5 30,,    MOV A, CNT_LL
007A,24 01,,    ADD A, #1       ; 加1
007C,D4,,    DA A            ; BCD调整(虽然存储的是HEX值0-99, 但逻辑上我们需要判100)
,,,                    ; 注意: 这里直接用HEX判断更简单, 因为DA A是针对BCD运算的
,,,                    ; 按照题目流程图逻辑：
007D,E5 30,,    MOV A, CNT_LL
007F,04,,    INC A           ; 寄存器值加1
0080,F5 30,,    MOV CNT_LL, A   ; 存回
,,,
0082,B4 64 24,,    CJNE A, #100, T1_EXIT ; 如果不等于100 (即0-99), 退出
,,,
,,,    ; --- 进位处理 1 ---
0085,75 30 00,,    MOV CNT_LL, #0  ; 清零最低2位
,,,
0088,E5 31,,    MOV A, CNT_LH   ; 取次低2位
008A,04,,    INC A
008B,F5 31,,    MOV CNT_LH, A
008D,B4 64 19,,    CJNE A, #100, T1_EXIT ; 判断是否满100
,,,
,,,    ; --- 进位处理 2 ---
0090,75 31 00,,    MOV CNT_LH, #0  ; 清零
,,,
0093,E5 32,,    MOV A, CNT_HL   ; 取次高2位
0095,04,,    INC A
0096,F5 32,,    MOV CNT_HL, A
0098,B4 64 0E,,    CJNE A, #100, T1_EXIT
,,,
,,,    ; --- 进位处理 3 ---
009B,75 32 00,,    MOV CNT_HL, #0  ; 清零
,,,
009E,E5 33,,    MOV A, CNT_HH   ; 取最高2位
00A0,04,,    INC A
00A1,F5 33,,    MOV CNT_HH, A
00A3,B4 64 03,,    CJNE A, #100, T1_EXIT
,,,
,,,    ; --- 溢出归零 (虽然很少发生) ---
00A6,75 33 00,,    MOV CNT_HH, #0
,,,
00A9,,T1_EXIT,T1_EXIT:
00A9,D0 E0,,    POP ACC         ; 恢复现场
00AB,D0 D0,,    POP PSW
00AD,32,,    RETI
,,,
00AE,,DISPLAY_ALL,DISPLAY_ALL:
,,,    ; 显示第8位 (最高位千万位) - 对应 CNT_HH 的十位
00AE,E5 33,,    MOV A, CNT_HH
00B0,75 F0 0A,,    MOV B, #10
00B3,84,,    DIV AB          ; A = 十位, B = 个位
00B4,90 01 3A,,    MOV DPTR, #TAB
00B7,93,,    MOVC A, @A+DPTR ; 查表得段码
00B8,75 80 00,,    MOV P0, #00H    ; 消隐
00BB,75 A0 FE,,    MOV P2, #0FEH   ; 选中第1位 (1111 1110)
00BE,F5 80,,    MOV P0, A       ; 输出段码
00C0,12 01 35,,    LCALL DELAY     ; 延时
,,,
,,,    ; 显示第7位 (百万位) - 对应 CNT_HH 的个位
00C3,E5 F0,,    MOV A, B        ; 取刚才DIV剩下的余数(个位)
00C5,93,,    MOVC A, @A+DPTR
00C6,75 80 00,,    MOV P0, #00H
00C9,75 A0 FD,,    MOV P2, #0FDH   ; 选中第2位 (1111 1101)
00CC,F5 80,,    MOV P0, A
00CE,12 01 35,,    LCALL DELAY
,,,
,,,    ; 显示第6位 (十万位) - 对应 CNT_HL 的十位
00D1,E5 32,,    MOV A, CNT_HL
00D3,75 F0 0A,,    MOV B, #10
00D6,84,,    DIV AB
00D7,93,,    MOVC A, @A+DPTR
00D8,75 80 00,,    MOV P0, #00H
00DB,75 A0 FB,,    MOV P2, #0FBH   ; 选中第3位
00DE,F5 80,,    MOV P0, A
00E0,12 01 35,,    LCALL DELAY
,,,
,,,    ; 显示第5位 (万位) - 对应 CNT_HL 的个位
00E3,E5 F0,,    MOV A, B
00E5,93,,    MOVC A, @A+DPTR
00E6,75 80 00,,    MOV P0, #00H
00E9,75 A0 F7,,    MOV P2, #0F7H   ; 选中第4位
00EC,F5 80,,    MOV P0, A
00EE,12 01 35,,    LCALL DELAY
,,,
,,,    ; 显示第4位 (千位) - 对应 CNT_LH 的十位
00F1,E5 31,,    MOV A, CNT_LH
00F3,75 F0 0A,,    MOV B, #10
00F6,84,,    DIV AB
00F7,93,,    MOVC A, @A+DPTR
00F8,75 80 00,,    MOV P0, #00H
00FB,75 A0 EF,,    MOV P2, #0EFH   ; 选中第5位
00FE,F5 80,,    MOV P0, A
0100,12 01 35,,    LCALL DELAY
,,,
,,,    ; 显示第3位 (百位) - 对应 CNT_LH 的个位
0103,E5 F0,,    MOV A, B
0105,93,,    MOVC A, @A+DPTR
0106,75 80 00,,    MOV P0, #00H
0109,75 A0 DF,,    MOV P2, #0DFH   ; 选中第6位
010C,F5 80,,    MOV P0, A
010E,12 01 35,,    LCALL DELAY
,,,
,,,    ; 显示第2位 (十位) - 对应 CNT_LL 的十位
0111,E5 30,,    MOV A, CNT_LL
0113,75 F0 0A,,    MOV B, #10
0116,84,,    DIV AB
0117,93,,    MOVC A, @A+DPTR
0118,75 80 00,,    MOV P0, #00H
011B,75 A0 BF,,    MOV P2, #0BFH   ; 选中第7位
011E,F5 80,,    MOV P0, A
0120,12 01 35,,    LCALL DELAY
,,,
,,,    ; 显示第1位 (个位) - 对应 CNT_LL 的个位
0123,E5 F0,,    MOV A, B
0125,93,,    MOVC A, @A+DPTR
0126,75 80 00,,    MOV P0, #00H
0129,75 A0 7F,,    MOV P2, #7FH    ; 选中第8位
012C,F5 80,,    MOV P0, A
012E,12 01 35,,    LCALL DELAY
,,,
0131,75 80 00,,    MOV P0, #00H    ; 关闭显示
0134,22,,    RET
,,,
,,,; 短延时子程序 (控制显示亮度与扫描频率)
0135,,DELAY,DELAY:
0135,7F 64,,    MOV R7, #100    ; 延时计数，可根据仿真速度调整
0137,DF FE,D1,D1: DJNZ R7, D1
0139,22,,    RET
,,,
,,,; 共阴极数码管段码表 (0-9)，对应: P0.0-P0.6 (A-G), P0.7 (DP)
013A,,TAB,TAB:
013A,3F 06 5B 4F,,    DB 3FH, 06H, 5BH, 4FH, 66H, 6DH, 7DH, 07H, 7FH, 6FH; 对应0~9
,,,
000E,,,    END
