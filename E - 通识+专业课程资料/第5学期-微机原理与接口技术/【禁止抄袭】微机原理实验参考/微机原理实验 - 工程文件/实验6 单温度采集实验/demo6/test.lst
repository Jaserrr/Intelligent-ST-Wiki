 Line  I  Addr  Code            Source

    1:		N      0000	ORG 0000H
    2:	  0000	02 00 40	LJMP MAIN
    3:		N      0003	ORG 0003H
    4:	  0003	02 00 71	LJMP INT0_Handler  ; 外部中断0跳转至对应服务函数
    5:		N      000B	ORG 000BH
    6:	  000B	02 00 82	LJMP T0_Handler    ; 定时器0中断跳转至对应服务函数
    7:		N      001B	ORG 001BH
    8:	  001B	02 00 88	LJMP T1_Handler    ; 定时器1中断跳转至对应服务函数
    9:
   10:		N      0040	ORG 0040H
   11:	  0040			MAIN:
   12:	  0040	75 81 5F	    MOV SP, #5FH         ; 栈指针设为5FH，分配足够堆栈空间
   13:				    ; 定时器0配置：模式2（8位自动重装），定时200个机器周期
   14:	  0043	75 8C 38	    MOV TH0, #-200
   15:	  0046	85 8C 8A	    MOV TL0, TH0
   16:				    ; 定时器1配置：模式1（16位），初值0FE0CH
   17:	  0049	75 8D FE	    MOV TH1, #0FEH
   18:	  004C	75 8B 0C	    MOV TL1, #0CH
   19:	  004F	75 89 52	    MOV TMOD, #52H       ; T1=模式1+计数器模式；T0=模式2+定时器模式
   20:	  0052	75 88 09	    MOV TCON, #09H       ; INT0边沿触发，预启动T0
   21:	  0055	75 B8 05	    MOV IP, #05H         ; INT0、T0设为高优先级中断
   22:	  0058	75 A8 8F	    MOV IE, #8FH         ; 开启总中断、INT0、T0、T1中断
   23:	  005B	75 30 A0	    MOV 30H, #0A0H       ; 初始化待显示数据存储单元
   24:	  005E	75 31 00	    MOV 31H, #00H        ; 初始化INT0中断计数单元
   25:	  0061	D2 8C		    SETB TR0              ; 启动定时器0
   26:	  0063	D2 8E		    SETB TR1              ; 启动定时器1
   27:
   28:				    ; 初始化显示位选引脚，P0口置高避免乱码
   29:	  0065	C2 A0		    CLR P2.0
   30:	  0067	C2 A1		    CLR P2.1
   31:	  0069	C2 A2		    CLR P2.2
   32:	  006B	75 80 FF	    MOV P0, #0FFH
   33:
   34:	  006E	02 00 6E	    LJMP $                ; 主程序循环等待中断
   35:
   36:				; 外部中断0服务函数：读取P0口数据并存储到30H
   37:	  0071			INT0_Handler:
   38:	  0071	05 31		    INC 31H               ; 累计INT0中断触发次数
   39:	  0073	D2 A7		    SETB P2.7       ; 显示使能
   40:	  0075	C2 B7		    CLR P3.7        ; 数据读取选通
   41:	  0077	00		    NOP
   42:	  0078	75 80 FF	    MOV P0, #0FFH
   43:	  007B	E5 80		    MOV A, P0       ; 读取P0口外部数据

