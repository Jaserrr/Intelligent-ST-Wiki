,,,ORG 0000H
0000,02 00 40,,LJMP MAIN
,,,ORG 0003H
0003,02 00 71,,LJMP INT0_Handler  ; 外部中断0跳转至对应服务函数
,,,ORG 000BH
000B,02 00 82,,LJMP T0_Handler    ; 定时器0中断跳转至对应服务函数
,,,ORG 001BH
001B,02 00 88,,LJMP T1_Handler    ; 定时器1中断跳转至对应服务函数
,,,
,,,ORG 0040H
0040,,MAIN,MAIN:
0040,75 81 5F,,    MOV SP, #5FH         ; 栈指针设为5FH，分配足够堆栈空间
,,,    ; 定时器0配置：模式2（8位自动重装），定时200个机器周期
0043,75 8C 38,,    MOV TH0, #-200
0046,85 8C 8A,,    MOV TL0, TH0
,,,    ; 定时器1配置：模式1（16位），初值0FE0CH
0049,75 8D FE,,    MOV TH1, #0FEH
004C,75 8B 0C,,    MOV TL1, #0CH
004F,75 89 52,,    MOV TMOD, #52H       ; T1=模式1+计数器模式；T0=模式2+定时器模式
0052,75 88 09,,    MOV TCON, #09H       ; INT0边沿触发，预启动T0
0055,75 B8 05,,    MOV IP, #05H         ; INT0、T0设为高优先级中断
0058,75 A8 8F,,    MOV IE, #8FH         ; 开启总中断、INT0、T0、T1中断
005B,75 30 A0,,    MOV 30H, #0A0H       ; 初始化待显示数据存储单元
005E,75 31 00,,    MOV 31H, #00H        ; 初始化INT0中断计数单元
0061,D2 8C,,    SETB TR0              ; 启动定时器0
0063,D2 8E,,    SETB TR1              ; 启动定时器1
,,,
,,,    ; 初始化显示位选引脚，P0口置高避免乱码
0065,C2 A0,,    CLR P2.0
0067,C2 A1,,    CLR P2.1
0069,C2 A2,,    CLR P2.2
006B,75 80 FF,,    MOV P0, #0FFH
,,,
006E,02 00 6E,,    LJMP $                ; 主程序循环等待中断
,,,
,,,; 外部中断0服务函数：读取P0口数据并存储到30H
0071,,INT0_Handler,INT0_Handler:
0071,05 31,,    INC 31H               ; 累计INT0中断触发次数
0073,D2 A7,,    SETB P2.7       ; 显示使能
0075,C2 B7,,    CLR P3.7        ; 数据读取选通
0077,00,,    NOP
0078,75 80 FF,,    MOV P0, #0FFH
007B,E5 80,,    MOV A, P0       ; 读取P0口外部数据
007D,F5 30,,    MOV 30H, A      ; 更新待显示数据
007F,D2 B7,,    SETB P3.7
0081,32,,    RETI
,,,
,,,; 定时器0中断服务函数：在P1.0输出窄脉冲
0082,,T0_Handler,T0_Handler:
0082,D2 90,,    SETB P1.0
0084,00,,    NOP
0085,C2 90,,    CLR P1.0
0087,32,,    RETI
,,,
,,,; 定时器1中断服务函数：分段显示30H中的数据（高位+低位）
0088,,T1_Handler,T1_Handler:
0088,C2 8E,,    CLR TR1               ; 关闭T1避免重装初值出错
008A,75 8D FE,,    MOV TH1, #0FEH        ; 重装T1初值
008D,75 8B 0C,,    MOV TL1, #0CH
0090,D2 8E,,    SETB TR1              ; 重启T1
0092,D2 A7,,    SETB P2.7       ; 显示使能
0094,C2 B6,,    CLR P3.6        ; 显示锁存
0096,79 0A,,    MOV R1, #10     ; 短延时稳定显示
0098,D9 FE,,    DJNZ R1, $
009A,D2 B6,,    SETB P3.6
,,,
,,,    ; 显示高位段码：从BCD_H查表输出到P0口
009C,E5 30,,    MOV A, 30H
009E,90 00 C5,,    MOV DPTR, #BCD_H
00A1,93,,    MOVC A, @A+DPTR
00A2,F5 80,,    MOV P0, A
00A4,D2 A0,,    SETB P2.0       ; 选通高位显示位
00A6,C2 A7,,    CLR P2.7
00A8,C2 B6,,    CLR P3.6
00AA,00,,    NOP
00AB,00,,    NOP
00AC,D2 A7,,    SETB P2.7
00AE,D2 B6,,    SETB P3.6
00B0,C2 A0,,    CLR P2.0
,,,
,,,    ; 显示低位段码：从BCD_L查表输出到P0口
00B2,E5 30,,    MOV A, 30H
00B4,90 01 C5,,    MOV DPTR, #BCD_L
00B7,93,,    MOVC A, @A+DPTR
00B8,F5 80,,    MOV P0, A
00BA,C2 A7,,    CLR P2.7
00BC,C2 B6,,    CLR P3.6
00BE,00,,    NOP
00BF,00,,    NOP
00C0,D2 A7,,    SETB P2.7
00C2,D2 B6,,    SETB P3.6
,,,
00C4,32,,    RETI
,,,
,,,; 高位显示段码表
00C5,,BCD_H,BCD_H:
00C5,1F 1F 1F 1F,,    DB 1FH, 1FH, 1FH, 1FH, 1FH, 1FH, 11H, 11H, 11H, 11H, 11H, 11H, 11H, 10H, 10H, 10H
00D5,10 10 10 10,,    DB 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H
00E5,10 10 10 10,,    DB 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H
00F5,10 10 10 10,,    DB 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H
0105,10 10 10 10,,    DB 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H
0115,10 10 10 10,,    DB 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H
0125,10 10 10 10,,    DB 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H
0135,10 10 10 10,,    DB 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H
0145,10 10 10 10,,    DB 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H
0155,10 10 10 10,,    DB 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H
0165,10 10 10 10,,    DB 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H
0175,10 10 10 10,,    DB 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H
0185,10 10 10 10,,    DB 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 10H, 00H, 00H, 00H, 00H, 00H
0195,00 00 00 00,,    DB 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H
01A5,00 00 00 00,,    DB 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H, 00H
01B5,00 00 00 00,,    DB 00H, 00H, 00H, 00H, 00H, 00H, 1FH, 1FH, 1FH, 1FH, 1FH, 1FH, 1FH, 1FH, 1FH, 1FH
,,,
,,,; 低位显示段码表
01C5,,BCD_L,BCD_L:
01C5,FF FF FF FF,,    DB 0FFH, 0FFH, 0FFH, 0FFH, 0FFH, 0FFH,  25H,  20H,  15H,  11H,  07H,  04H,  01H,  98H,  96H,  93
